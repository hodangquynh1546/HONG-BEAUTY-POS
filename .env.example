# Docker Compose uses POSTGRES_* for its local database. DATABASE_URL is for direct API or Render deployment.
POSTGRES_DB=mieu_pos
POSTGRES_USER=mieu
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
APP_PORT=8080
DATABASE_URL=Host=localhost;Port=5432;Database=mieu_pos;Username=mieu;Password=CHANGE_ME_STRONG_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
RUN_MIGRATIONS_ON_START=true
BOOTSTRAP_OWNER_ON_START=true
OWNER_EMAIL=ban@congty.com
OWNER_NAME=Chu cua hang
OWNER_PASSWORD=CHANGE_ME_WITH_A_STRONG_PRIVATE_PASSWORD_1!
CORS_ALLOWED_ORIGINS=
