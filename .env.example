# ============================================================================
# Miêu POS — biến môi trường
# Sao chép file này thành `.env` rồi điền giá trị. KHÔNG commit `.env`.
#   [BẮT BUỘC] phải điền   [TÙY CHỌN] có mặc định an toàn
# Mẹo sinh bí mật ngẫu nhiên:  openssl rand -base64 48
# ============================================================================

# ---------- Cơ sở dữ liệu ---------------------------------------------------
# [BẮT BUỘC khi dùng docker compose] PostgreSQL chạy trong compose.
# Chỉ dùng chữ, số, "-" hoặc "_" cho mật khẩu (ký tự ; = làm hỏng chuỗi kết nối).
POSTGRES_DB=mieu_pos
POSTGRES_USER=mieu
POSTGRES_PASSWORD=

# [BẮT BUỘC khi chạy API trực tiếp hoặc trên Render] Compose tự dựng giá trị này từ POSTGRES_*.
# Dạng Npgsql:  Host=localhost;Port=5432;Database=mieu_pos;Username=mieu;Password=...
# Dạng URI (Neon): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# ---------- Bảo mật ---------------------------------------------------------
# [BẮT BUỘC] Khóa ký JWT, tối thiểu 32 ký tự ngẫu nhiên. Đổi khóa = mọi phiên đăng nhập hết hạn.
JWT_SECRET=

# [TÙY CHỌN] Phiên đăng nhập: access token sống ngắn (phút, 1–1440) + refresh token xoay vòng (ngày, 1–365).
# Hết hạn access token app tự gia hạn bằng refresh token; không dùng quá 30 ngày nếu không hoạt động.
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Số lần đăng nhập tối đa mỗi phút trên mỗi IP (chống dò mật khẩu).
LOGIN_RATE_LIMIT_PER_MINUTE=20

# [TÙY CHỌN] Origin được gọi API từ trình duyệt/app khác origin, ngăn cách bằng dấu phẩy.
# Bản web phục vụ cùng origin nên để trống. App Capacitor cần: https://localhost,capacitor://localhost
CORS_ALLOWED_ORIGINS=

# [TÙY CHỌN] true khi chạy sau reverse proxy (Render, nginx) để giới hạn đăng nhập theo IP thật.
# Chỉ bật khi thật sự có proxy phía trước; nếu không, IP có thể bị giả mạo.
FORWARDED_HEADERS_ENABLED=false

# ---------- Ứng dụng --------------------------------------------------------
# [TÙY CHỌN] Development | Production. Swagger chỉ bật ở Development.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
# Cổng công khai của compose (host).
APP_PORT=8080

# [TÙY CHỌN] true = tự áp dụng migration mỗi lần khởi động.
RUN_MIGRATIONS_ON_START=true

# ---------- Tài khoản Chủ sở hữu (tạo lần đầu) -------------------------------
# [TÙY CHỌN] true = nếu chưa có Owner thì tạo từ 3 biến bên dưới khi khởi động.
# Sau khi đăng nhập được, đặt lại false và xóa OWNER_PASSWORD khỏi môi trường.
BOOTSTRAP_OWNER_ON_START=true
OWNER_EMAIL=
OWNER_NAME=
# 14–128 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
OWNER_PASSWORD=

# ---------- Kiểm thử (chỉ máy dev) ------------------------------------------
# Database localhost TRỐNG, chỉ dành cho tests/integration_smoke.py. Không dùng DB thật.
POS_TEST_DATABASE_URL=
