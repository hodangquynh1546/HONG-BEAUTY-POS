# Copy to .env.production on the server and fill every empty value. Never commit the filled file.

# Public host name that points at the server's Elastic IP (no https://, no slash).
# No domain? Use  <ip-with-dashes>.sslip.io  e.g. 3-14-15-92.sslip.io for IP 3.14.15.92
DOMAIN=

POSTGRES_DB=mieu_pos
POSTGRES_USER=mieu
# Letters, digits, - and _ only.
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=

JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=20
# Origins allowed to call the API from another origin (only the Android/iOS app): https://localhost,capacitor://localhost
CORS_ALLOWED_ORIGINS=

# First start only: creates the owner when none exists. Afterwards set BOOTSTRAP_OWNER_ON_START=false and delete OWNER_PASSWORD.
BOOTSTRAP_OWNER_ON_START=true
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# Backups (used by backup.sh)
BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=30
